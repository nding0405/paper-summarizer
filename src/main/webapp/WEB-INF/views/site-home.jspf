<%-- Top-left reset: back to the unfiltered paper list. Expects searchPath. --%>
<a class="icon-button home-link" href="<c:out value='${searchPath}' />" aria-label="Reset and show all papers" title="Reset and show all papers">
  <svg class="icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <path d="M3 11.5 12 4l9 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M5.5 10.5V20h13v-9.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
  </svg>
</a>
